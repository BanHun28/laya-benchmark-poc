and Maintenance": "downtime, outages, scheduled maintenance", "Sales and Pre-Sales": "pricing, quotes, buying", "Human Resources": "employment, payroll, leave, hiring", "General Inquiry": "anything else"}}}, "expected": {"queue": "Service Outages and Maintenance"}, "tags": ["support_tickets", "id:58181", "t3arm:train"], "language": "en"}
