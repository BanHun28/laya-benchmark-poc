ke place ."}, "questions": {"is_spam": {"type": "noul", "instructions": "Is this email unsolicited spam or bulk marketing?"}}, "expected": {"is_spam": false}, "tags": ["enron_spam", "id:26490", "t3arm:train"], "language": "en"}
